services:
  blog:
    build: .
    container_name: couple-blog
    restart: unless-stopped
    ports:
      - "3000:3000"
    environment:
      SITE_TITLE: 标题
      # 开始的日期
      ANNIVERSARY: "2024-05-20"
      # true 时访客必须登录才能浏览
      PRIVATE_MODE: "false"
      # 必改!随机长字符串,可用 openssl rand -hex 32 生成
      JWT_SECRET: "change-me-to-a-random-string"
    volumes:
      - ./data:/app/data
