services:
  blog:
    # 默认跟随 latest；固定版本时改成 ghcr.io/nzesupb/liteblog:1.2.3
    image: ghcr.io/nzesupb/liteblog:latest
    pull_policy: always
    container_name: couple-blog
    restart: unless-stopped
    ports:
      - "3000:3000"
    environment:
      # 站点显示配置
      SITE_TITLE: "我们的日常"
      ANNIVERSARY: "2024-05-20"
      PRIVATE_MODE: "false" # true 时访客必须登录才能浏览
      # 必填:随机长字符串
      JWT_SECRET: "请替换为随机长字符串,可用 openssl rand -hex 32 生成"
    volumes:
      - ./data:/app/data
