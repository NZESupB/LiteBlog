{
  "name": "couple-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "情侣日常记录博客,轻量自托管",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node scripts/dev.mjs",
    "build": "vite build --config frontend/vite.config.ts && node scripts/generate-sw-assets.mjs",
    "syntax": "node scripts/check-syntax.mjs",
    "typecheck": "tsc --project frontend/tsconfig.json",
    "lint": "eslint frontend/src",
    "format:check": "prettier --check 'frontend/src/**/*.{ts,tsx}'",
    "test": "node scripts/test.mjs",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "check": "npm run syntax && npm run typecheck && npm run lint && npm run format:check && npm run build && npm test && npm run test:unit"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dompurify": "3.4.17",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "lucide-react": "1.61.0",
    "marked": "18.1.1",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
